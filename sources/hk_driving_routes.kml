            114.2295,22.2792,0
          </coordinates>
        </LineString>
      </Placemark>

      <Placemark>
        <name>④ 起點：銅鑼灣</name>
        <description>東區走廊西端起點（銅鑼灣維園道口）</description>
        <styleUrl>#point_start</styleUrl>
        <Point>
          <coordinates>114.1885,22.2852,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>④ 終點：筲箕灣</name>
        <description>東區走廊東端（筲箕灣）</description>
        <styleUrl>#point_end</styleUrl>
        <Point>
