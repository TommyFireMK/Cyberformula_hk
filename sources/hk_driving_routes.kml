<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>香港路線圖（港島山道線及市區四大路線）</name>
    <description>包含圖 1（灣仔告士打道至赤柱峽道山道線及替代路線）與圖 2（觀塘繞道、龍翔道及呈祥道、西九龍公路、東區走廊）共 5 條主要路線與起訖點標記。</description>

    <!-- 路線與標記樣式定義 -->
    <Style id="route_hk_island_blue">
      <LineStyle>
        <color>ffff6600</color>
        <width>6</width>
      </LineStyle>
    </Style>
    <Style id="route_hk_island_alt">
      <LineStyle>
        <color>ff888888</color>
        <width>4</width>
      </LineStyle>
    </Style>
    <Style id="route_red_1">
      <LineStyle>
        <color>ff1c1ce6</color>
        <width>6</width>
      </LineStyle>
    </Style>
    <Style id="route_red_2">
      <LineStyle>
        <color>ff0055ff</color>
        <width>6</width>
      </LineStyle>
    </Style>
    <Style id="route_red_3">
      <LineStyle>
        <color>ff2222cc</color>
        <width>6</width>
      </LineStyle>
    </Style>
    <Style id="route_red_4">
      <LineStyle>
        <color>ff0000dd</color>
        <width>6</width>
      </LineStyle>
    </Style>
    <Style id="point_start">
      <IconStyle>
        <scale>1.1</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/paddle/grn-circle.png</href>
        </Icon>
      </IconStyle>
    </Style>
    <Style id="point_end">
      <IconStyle>
        <scale>1.1</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/paddle/red-stars.png</href>
        </Icon>
      </IconStyle>
    </Style>
    <Style id="point_waypoint">
      <IconStyle>
        <scale>0.9</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/paddle/ylw-blank.png</href>
        </Icon>
      </IconStyle>
    </Style>

    <!-- 圖 1：港島山道至南區路線 -->
    <Folder>
      <name>圖 1：港島山道至赤柱峽道線</name>
      <description>灣仔告士打道經紅棉路、花園道、馬己仙峽道、司徒拔道、黃泥涌峽道、淺水灣道至赤柱峽道</description>

      <Placemark>
        <name>港島山道主路線（告士打道 → 赤柱峽道）</name>
        <description><![CDATA[
          <b>路線：</b>灣仔告士打道 → 紅棉路 → 花園道 → 馬己仙峽道 → 司徒拔道 → 黃泥涌峽道 → 淺水灣道 → 赤柱峽道<br/>
          <b>距離：</b>約 13.6–15.1 公里（預估 25–30 分鐘）<br/>
          <b>Google Maps 導航：</b><a href="https://www.google.com/maps/dir/%E9%A6%99%E6%B8%AF%E9%A6%99%E6%B8%AF%E5%B3%B6%E7%81%A3%E4%BB%94%E5%91%8A%E5%A3%AB%E6%89%93%E9%81%93/%E9%A6%99%E6%B8%AF%E9%A6%99%E6%B8%AF%E5%B3%B6%E4%B8%AD%E7%92%B0%E8%8A%B1%E5%9C%92%E9%81%93/%E9%A6%99%E6%B8%AF%E9%A6%99%E6%B8%AF%E5%B3%B6%E7%81%A3%E4%BB%94%E5%8F%B8%E5%BE%92%E6%8B%94%E9%81%93/%E9%A6%99%E6%B8%AF%E9%A6%99%E6%B8%AF%E5%B3%B6%E6%B7%BA%E6%B0%B4%E7%81%A3%E9%81%93/%E9%A6%99%E6%B8%AF%E9%A6%99%E6%B8%AF%E5%B3%B6%E8%B5%A4%E6%9F%B1%E5%B3%BD%E9%81%93/data=!4m17!4m16!1m2!1m1!19sIi4qLAoUChIJJbiLwlkABDQR5C863y_pwNASFAoSCXn-YX5bAAQ0Ee7YwzXmcSUk!1m2!1m1!19sIi4qLAoUChIJcybcfmUABDQRxtj39-r_pLQSFAoSCb3RHaNkAAQ0EVK1zN47pwdQ!1m2!1m1!19sIi4qLAoUChIJqTBAxUUABDQRq73kHCLWkwESFAoSCXn-YX5bAAQ0Ee7YwzXmcSUk!1m2!1m1!19sChIJV1T_M9QBBDQRtmAIN2uHBXM!1m2!1m1!19sChIJw-FsAG6qBjQRWpcg3_fqRk8!3e0">點擊開啟路線</a>
        ]]></description>
        <styleUrl>#route_hk_island_blue</styleUrl>
        <LineString>
          <tessellate>1</tessellate>
          <coordinates>
            114.1706,22.2793,0
            114.1645,22.2798,0
            114.1618,22.2775,0
            114.1598,22.2758,0
            114.1585,22.2764,0
            114.1568,22.2748,0
            114.1552,22.2725,0
            114.1535,22.2705,0
            114.1565,22.2690,0
            114.1578,22.2662,0
            114.1622,22.2650,0
