            114.1622,22.3065,0
          </coordinates>
        </LineString>
      </Placemark>

      <Placemark>
        <name>③ 起點：荔景</name>
        <description>青葵公路／西九龍公路北端（荔景）</description>
        <styleUrl>#point_start</styleUrl>
        <Point>
          <coordinates>114.1275,22.3485,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>③ 終點：西九龍</name>
        <description>西九龍公路南端（西九龍／油麻地交匯處）</description>
        <styleUrl>#point_end</styleUrl>
        <Point>
          <coordinates>114.1622,22.3065,0</coordinates>
        </Point>
      </Placemark>

      <!-- 路線 ④ 東區走廊 -->
      <Placemark>
        <name>④ 東區走廊（銅鑼灣 ↔ 筲箕灣）</name>
        <description><![CDATA[
          <b>路線：</b>銅鑼灣 ↔ 東區走廊（4號幹線）↔ 筲箕灣<br/>
          <b>距離：</b>約 10.7 公里（預估 16 分鐘）<br/>
          <b>Google Maps 導航：</b><a href="https://www.google.com/maps/dir/%E9%A6%99%E6%B8%AF%E9%A6%99%E6%B8%AF%E5%B3%B6%E9%8A%85%E9%91%BC%E7%81%A3/%E9%A6%99%E6%B8%AF%E6%9D%B1%E5%8D%80%E8%B5%B0%E5%BB%8A/%E9%A6%99%E6%B8%AF%E9%A6%99%E6%B8%AF%E5%B3%B6%E7%AD%B2%E7%AE%95%E7%81%A3/data=!4m11!4m10!1m2!1m1!19sChIJf6xts1UABDQRagwS57GoPwI!1m2!1m1!19sChIJuT92ZaABBDQRD4kYTaiwlwk!1m2!1m1!19sChIJ3fW7GXgBBDQRxLDGFE9ILpg!3e0">點擊開啟路線</a>
        ]]></description>
