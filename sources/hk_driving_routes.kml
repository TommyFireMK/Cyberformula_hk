            114.1865,22.3422,0
            114.1935,22.3418,0
            114.2005,22.3402,0
            114.2066,22.3367,0
          </coordinates>
        </LineString>
      </Placemark>

      <Placemark>
        <name>② 起點：蝴蝶谷</name>
        <description>呈祥道西端起點（荔枝角蝴蝶谷）</description>
        <styleUrl>#point_start</styleUrl>
        <Point>
          <coordinates>114.1425,22.3408,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>② 終點：彩虹</name>
        <description>龍翔道東端終點（彩虹交匯處／彩虹邨）</description>
        <styleUrl>#point_end</styleUrl>
        <Point>
          <coordinates>114.2066,22.3367,0</coordinates>
        </Point>
      </Placemark>

      <!-- 路線 ③ 西九龍公路 -->
      <Placemark>
        <name>③ 西九龍公路（荔景 ↔ 西九龍）</name>
        <description><![CDATA[
          <b>路線：</b>荔景（青葵公路）↔ 西九龍公路（3號幹線）↔ 西九龍<br/>
          <b>距離：</b>約 12.1–13.5 公里（預估 12–14 分鐘）<br/>
          <b>Google Maps 導航：</b><a href="https://www.google.com/maps/dir/%E9%A6%99%E6%B8%AF%E9%9D%92%E8%91%B5%E5%85%AC%E8%B7%AF/%E9%A6%99%E6%B8%AF%E4%B9%9D%E9%BE%8D%E6%B2%B9%E9%BA%BB%E5%9C%B0%E8%A5%BF%E4%B9%9D%E9%BE%8D%E5%85%AC%E8%B7%AF/data=!4m8!4m7!1m2!1m1!19sChIJF9oF6LP4AzQRqeqXX563rJ0!1m2!1m1!19sIi4qLAoUChIJQwxcqqUABDQRZ0fsP_zYFi4SFAoSCVeE9jOVAAQ0EYIyJYf_7PRp!3e0">點擊開啟路線</a>
        ]]></description>
        <styleUrl>#route_red_3</styleUrl>
        <LineString>
          <tessellate>1</tessellate>
          <coordinates>
            114.1275,22.3485,0
            114.1328,22.3415,0
