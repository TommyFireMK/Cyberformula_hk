            114.1905,22.2470,0
            114.1895,22.2435,0
            114.1938,22.2398,0
            114.1982,22.2368,0
            114.2015,22.2345,0
            114.2028,22.2305,0
            114.2052,22.2268,0
            114.2085,22.2238,0
            114.2125,22.2195,0
          </coordinates>
        </LineString>
      </Placemark>

      <Placemark>
        <name>替代路線：經香港仔隧道（1號幹線）</name>
        <description><![CDATA[
          <b>路線：</b>灣仔告士打道 → 堅拿道天橋 → 香港仔隧道（1號幹線）→ 香島道 → 淺水灣道 → 赤柱峽道<br/>
          <b>距離：</b>約 11.8–12.0 公里（預估 16–23 分鐘）
        ]]></description>
        <styleUrl>#route_hk_island_alt</styleUrl>
        <LineString>
          <tessellate>1</tessellate>
          <coordinates>
            114.1706,22.2793,0
            114.1755,22.2795,0
            114.1802,22.2788,0
            114.1798,22.2735,0
            114.1785,22.2615,0
            114.1765,22.2505,0
            114.1795,22.2465,0
            114.1865,22.2442,0
            114.1895,22.2435,0
            114.1938,22.2398,0
            114.1982,22.2368,0
            114.2015,22.2345,0
            114.2028,22.2305,0
            114.2052,22.2268,0
            114.2085,22.2238,0
            114.2125,22.2195,0
          </coordinates>
        </LineString>
      </Placemark>

      <Placemark>
        <name>起點：告士打道（灣仔）</name>
        <description>港島山道線起點（灣仔告士打道）</description>
        <styleUrl>#point_start</styleUrl>
        <Point>
          <coordinates>114.1706,22.2793,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>途經點：馬己仙峽道／司徒拔道交界</name>
        <description>山頂馬己仙峽道接司徒拔道彎段</description>
        <styleUrl>#point_waypoint</styleUrl>
        <Point>
          <coordinates>114.1622,22.2650,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>途經點：黃泥涌峽道</name>
        <description>司徒拔道迴旋處接黃泥涌峽道及淺水灣道</description>
        <styleUrl>#point_waypoint</styleUrl>
        <Point>
          <coordinates>114.1932,22.2555,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>終點：赤柱峽道</name>
        <description>港島山道線終點（赤柱峽道近赤柱道交界）</description>
        <styleUrl>#point_end</styleUrl>
        <Point>
          <coordinates>114.2125,22.2195,0</coordinates>
        </Point>
      </Placemark>
    </Folder>

    <!-- 圖 2：市區四大路線 -->
    <Folder>
      <name>圖 2：市區四大路線（熱點 ① 至 ④）</name>
      <description>包含 ① 觀塘繞道、② 龍翔道及呈祥道、③ 西九龍公路、④ 東區走廊</description>

      <!-- 路線 ① 觀塘繞道 -->
      <Placemark>
        <name>① 觀塘繞道（鑽石山 ↔ 藍田）</name>
        <description><![CDATA[
          <b>路線：</b>鑽石山（彩虹交匯處）↔ 觀塘繞道（2號幹線）↔ 藍田<br/>
          <b>距離：</b>約 10.2 公里（預估 19 分鐘）<br/>
          <b>Google Maps 導航：</b><a href="https://www.google.com/maps/dir/%E9%91%BD%E7%9F%B3%E5%B1%B1/%E9%A6%99%E6%B8%AF%E4%B9%9D%E9%BE%8D%E8%A7%80%E5%A1%98%E7%B9%9E%E9%81%93/%E9%A6%99%E6%B8%AF%E4%B9%9D%E9%BE%8D%E8%97%8D%E7%94%B0/data=!4m11!4m10!1m2!1m1!19sChIJqZSPc-cGBDQRmn1Sua3ZQAI!1m2!1m1!19sChIJdx4V1EoBBDQR3GLHVvbcbnw!1m2!1m1!19sChIJhfHoFlgBBDQRYMo4jzN3Q3Y!3e0">點擊開啟路線</a>
        ]]></description>
        <styleUrl>#route_red_1</styleUrl>
        <LineString>
          <tessellate>1</tessellate>
          <coordinates>
            114.2045,22.3365,0
            114.2082,22.3315,0
            114.2088,22.3260,0
            114.2098,22.3210,0
            114.2120,22.3175,0
            114.2155,22.3135,0
            114.2195,22.3105,0
            114.2235,22.3078,0
            114.2275,22.3048,0
            114.2318,22.3038,0
          </coordinates>
        </LineString>
      </Placemark>

      <Placemark>
        <name>① 起點：鑽石山</name>
        <description>觀塘繞道北端起點（鑽石山／彩虹交匯處）</description>
        <styleUrl>#point_start</styleUrl>
        <Point>
          <coordinates>114.2045,22.3365,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>① 終點：藍田</name>
        <description>觀塘繞道東南端終點（藍田／鯉魚門道交匯處）</description>
        <styleUrl>#point_end</styleUrl>
        <Point>
          <coordinates>114.2318,22.3038,0</coordinates>
        </Point>
      </Placemark>

      <!-- 路線 ② 龍翔道、呈祥道 -->
      <Placemark>
        <name>② 龍翔道、呈祥道（蝴蝶谷 ↔ 彩虹）</name>
        <description><![CDATA[
          <b>路線：</b>蝴蝶谷 ↔ 呈祥道 ↔ 龍翔道（7號幹線）↔ 彩虹<br/>
          <b>距離：</b>約 11.1 公里（預估 12 分鐘）<br/>
          <b>Google Maps 導航：</b><a href="https://www.google.com/maps/dir/%E9%A6%99%E6%B8%AF%E4%B9%9D%E9%BE%8D%E5%91%88%E7%A5%A5%E9%81%93/%E9%BE%8D%E7%BF%94%E9%81%93;+%E5%BD%A9%E8%99%B9%E9%82%A8%E7%B4%85%E8%90%BC%E6%A8%93%E5%A4%96/data=!4m11!4m10!1m2!1m1!19sChIJHx1nklUHBDQR4lwLSxx2CBk!1m5!1m1!19sChIJNafFgcUGBDQR9Iz8wJBf5Q8!2m2!1d114.20664!2d22.336689999999997!3e0">點擊開啟路線</a>
        ]]></description>
        <styleUrl>#route_red_2</styleUrl>
        <LineString>
          <tessellate>1</tessellate>
          <coordinates>
            114.1425,22.3408,0
            114.1475,22.3418,0
            114.1535,22.3435,0
            114.1595,22.3442,0
            114.1645,22.3432,0
            114.1678,22.3428,0
